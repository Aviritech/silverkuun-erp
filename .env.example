# Supabase project settings (Project Settings → API). The anon key is safe in the browser:
# row level security decides what each signed-in staff member can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only, never NEXT_PUBLIC. Lets HR and System Administrators create logins, reset passwords and block
# sign-in for staff who leave. Locally, `npx supabase status` prints it as the service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
